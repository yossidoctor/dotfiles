karabiner/automatic_backups/
karabiner/assets/
# gh writes oauth tokens here on file-based (non-keychain) auth; ~/.config/gh
# is a whole-dir symlink into this repo, so an untracked+ignored hosts.yml keeps
# a leaked token out of git. config.yml stays tracked (no secrets).
/gh/hosts.yml
# Compiled from the matching .c by sketchybar/makefile, which sketchybarrc runs
# on startup when a binary is missing or stale. The sources are tracked; the
# machine-local build products are not.
/sketchybar/pointer-y
