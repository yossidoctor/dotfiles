# ── taps ──────────────────────────────────────────────────────────
tap "felixkratz/formulae"           # tap for borders
tap "nikitabobko/tap"               # tap for aerospace

# ── shell & prompt ─────────────────────────────────────────────────
brew "fzf"                          # backs fzf-tab and Ctrl-R/Ctrl-T bindings
brew "fzf-tab"                      # replaces the zsh completion menu with an fzf fuzzy selector
brew "starship"                     # cross-shell prompt
brew "zoxide"                       # frecency-ranked dir jumping — `z X` instead of `cd ~/long/path/X`
brew "zsh-syntax-highlighting"

# ── file & dir tools ───────────────────────────────────────────────
brew "bat"                          # syntax-highlighted file printing with line numbers, git gutter, paging
brew "duf"                          # colorized disk/mount table, grouped sensibly
brew "dust"                         # visual tree of what's eating disk, sorted, with bars
brew "eza"                          # colorized listing, icons, tree view, git status per file
brew "fd"                           # fast find replacement — gitignore-aware, regex by default
brew "glow"                         # markdown renderer for the terminal
brew "ripgrep"                      # fast recursive content search — `rg`, gitignore-aware

# ── dev core ───────────────────────────────────────────────────────
brew "ast-grep"                     # structural code search/rewrite by syntax-tree pattern
brew "difftastic"                   # AST-aware structural diff — on-demand alongside delta for refactor/reformat noise
brew "dotbot"                       # dotfiles symlink bootstrapper
brew "gh"                           # GitHub CLI
brew "git"                          # version control
brew "git-delta"                    # syntax-highlighted, side-by-side git diff pager
brew "git-filter-repo"              # history rewriting — path/blob removal across all commits
brew "hyperfine"                    # benchmarking with warmup + deviation; SoT for any timing claim
brew "jq"                           # JSON query/build — the hook-path JSON tool
brew "shellcheck"                   # static analysis for the repo's bash scripts
brew "tlrc"                         # crowd-sourced example-first command help

# ── languages & runtime ────────────────────────────────────────────
brew "fnm"                          # Fast Node Manager — per-dir Node via .nvmrc (zshrc auto-switch)
brew "uv"                           # Python package installer / tool runner (claude-swap)

# ── system monitors ────────────────────────────────────────────────
brew "btop"                         # animated TUI resource monitor
brew "procs"                        # colorized process listing, tree view, searchable

