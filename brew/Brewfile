# ── taps ──────────────────────────────────────────────────────────
# `trusted:` names the one item taken from each tap; `brew bundle cleanup` resets
# the global trust store to what a Brewfile declares, so trust granted only from
# a shell would not survive it.
tap "felixkratz/formulae", trusted: { formula: "borders" }
tap "nikitabobko/tap", trusted: { cask: "aerospace" }

# ── shell & prompt ─────────────────────────────────────────────────
brew "fzf"                          # fuzzy finder; backs the Ctrl-R/Ctrl-T bindings
brew "starship"                     # cross-shell prompt (starship/starship.toml)
brew "zsh-syntax-highlighting"      # colors commands as you type

# ── file & dir tools ───────────────────────────────────────────────
brew "fd"                           # fast find replacement, gitignore-aware
brew "ripgrep"                      # fast recursive content search (`rg`), gitignore-aware

# ── dev core ───────────────────────────────────────────────────────
brew "ast-grep"                     # structural code search/rewrite by syntax-tree pattern
brew "difftastic"                   # syntax-aware diff; on demand alongside delta for refactor/reformat noise
brew "dotbot"                       # runs install.conf.yaml: this repo's symlinks and install steps
brew "gh"                           # GitHub CLI
brew "git"                          # version control
brew "git-delta"                    # syntax-highlighted, side-by-side git diff pager
brew "git-absorb"                   # routes staged fixup hunks into the commits that introduced the lines
brew "git-filter-repo"              # history rewriting — path/blob removal across all commits
brew "hyperfine"                    # command benchmarking with warmup + deviation; SoT for any timing claim
brew "jq"                           # JSON query/build; the hook-path JSON tool
brew "mergiraf"                     # syntax-aware git merge driver (git/config, git/attributes)
brew "shellcheck"                   # static analysis for the repo's bash scripts

# ── languages & runtime ────────────────────────────────────────────
brew "fnm"
brew "python"
brew "uv"

