# ── taps ──────────────────────────────────────────────────────────
# `trusted:` names the one item taken from each tap; `brew bundle cleanup` resets
# the global trust store to what a Brewfile declares, so trust granted only from
# a shell would not survive it.
tap "felixkratz/formulae", trusted: { formula: "borders" }
tap "nikitabobko/tap", trusted: { cask: "aerospace" }

# ── shell & prompt ─────────────────────────────────────────────────
brew "fzf"                          # backs the Ctrl-R/Ctrl-T bindings
brew "starship"                     # cross-shell prompt
brew "zsh-syntax-highlighting"

# ── file & dir tools ───────────────────────────────────────────────
brew "fd"                           # fast find replacement — gitignore-aware, regex by default
brew "ripgrep"                      # fast recursive content search — `rg`, gitignore-aware

# ── dev core ───────────────────────────────────────────────────────
brew "ast-grep"                     # structural code search/rewrite by syntax-tree pattern
brew "difftastic"                   # AST-aware structural diff — on-demand alongside delta for refactor/reformat noise
brew "dotbot"                       # dotfiles symlink bootstrapper
brew "gh"                           # GitHub CLI
brew "git"                          # version control
brew "git-delta"                    # syntax-highlighted, side-by-side git diff pager
brew "git-absorb"                   # routes staged fixup hunks into the commits that introduced the lines
brew "git-filter-repo"              # history rewriting — path/blob removal across all commits
brew "hyperfine"                    # benchmarking with warmup + deviation; SoT for any timing claim
brew "jq"                           # JSON query/build — the hook-path JSON tool
brew "mergiraf"                     # syntax-aware git merge driver — git/config [merge "mergiraf"], git/attributes
brew "shellcheck"                   # static analysis for the repo's bash scripts

# ── data & http ────────────────────────────────────────────────────
brew "duckdb"                       # SQL over CSV/JSON/NDJSON files in place — log and export analysis
brew "hurl"                         # HTTP requests + assertions as plain-text files, CI exit codes

# ── languages & runtime ────────────────────────────────────────────
brew "fnm"                          # Fast Node Manager — per-dir Node via .nvmrc (zshrc auto-switch)
brew "uv"                           # Python package installer / tool runner (claude-swap)

# ── mac utilities ──────────────────────────────────────────────────
cask "adguard"                      # system-wide ad / tracker blocker
cask "appcleaner"                   # uninstaller that also removes app support files
brew "duti"                         # set macOS default apps per file type / URL scheme
cask "karabiner-elements"           # low-level keyboard remapping
cask "notunes"                      # blocks Apple Music from auto-launching
brew "terminal-notifier"            # notification banners from scripts; ships as an app bundle macOS can grant, which osascript from a terminal cannot be
# Raycast runs from its Beta channel ("Raycast Beta.app", installed from raycast.com);
# no cask ships that channel and `cask "raycast"` would add a second, stable copy.
# It owns ⌘Space: mac/defaults.sh unbinds Spotlight, mac/disable-spotlight.sh stops the indexer.

# ── window management ──────────────────────────────────────────────
cask "aerospace"                    # i3-style tiling window manager
cask "bettercmdtab"
cask "betterdisplay"
cask "hammerspoon"                  # quits listed apps when their last window closes (hammerspoon/init.lua)
brew "borders"                      # JankyBorders — colored outline on the AeroSpace-focused window

# ── gui apps ───────────────────────────────────────────────────────
cask "affinity"                     # Affinity photo/design suite
cask "claude-code@latest"
cask "expressvpn"
cask "font-jetbrains-mono-nerd-font" # JetBrains Mono + Nerd Font glyphs
cask "ghostty"                      # GPU-accelerated terminal emulator
cask "iina"                         # media player (mpv-based); prefs in mac/defaults.sh
cask "linear"
cask "slack"
cask "spotify"
cask "stremio"                      # media streaming client
cask "transmission"                 # BitTorrent client
cask "visual-studio-code"
cask "whatsapp"
cask "zoom"

# ── vscode extensions (vscode/settings.json configures these) ──────
vscode "davidanson.vscode-markdownlint"
vscode "eamodio.gitlens"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "ms-python.vscode-python-envs"
vscode "tamasfe.even-better-toml"
vscode "zhuangtongfa.material-theme"  # One Dark Pro
