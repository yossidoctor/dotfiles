{
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.03,
  "env": {
    "PATH": "/Users/yossidoctor/.local/share/fnm/aliases/default/bin:/Users/yossidoctor/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "HOMEBREW_NO_ANALYTICS": "1",
    "PAGER": "cat",
    "CI": "1",
    "NO_COLOR": "1",
    "BASH_MAX_OUTPUT_LENGTH": "100000",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "24",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "PONYTAIL_DEFAULT_MODE": "full"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(dd *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(diskutil reformat *)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(shred *)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git * push --force)",
      "Bash(git * push --force *)",
      "Bash(git * push * --force)",
      "Bash(git * push * --force *)",
      "Bash(git * push -f)",
      "Bash(git * push -f *)",
      "Bash(git * push * -f)",
      "Bash(git * push * -f *)",
      "Bash(git * push * +*)",
      "Bash(git * push --mirror *)",
      "Bash(git * push --delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh cache delete *)",
      "Bash(gh secret delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git * push * --delete *)",
      "Bash(git * push * -d *)"
    ],
    "ask": [
      "Bash(git branch -D *)",
      "Bash(git reset --hard *)",
      "Bash(git tag -d *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git -C * push --force-with-lease*)",
      "Bash(git * reset --hard *)",
      "Bash(git * branch -D *)",
      "Bash(git * tag -d *)",
      "Bash(git checkout -- *)",
      "Bash(git * checkout -- *)",
      "Bash(git clean *)",
      "Bash(git * clean *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git * stash drop*)",
      "Bash(git * stash clear*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git * push * --force-with-lease*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/yossidoctor/dotfiles"
    ]
  },
  "model": "opus",
  "availableModels": [
    "fable",
    "opus",
    "sonnet",
    "haiku"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/enforce-foreground-polling.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/enforce-read-over-shell-read.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/enforce-git-add-paths.sh",
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/rewrite-fable-subagent.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/redirect-symlink-edits.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/warn-existing-occurrence.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/log-permission-denied.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/caffeinate-claude.sh active",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/caffeinate-claude.sh linger",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/audit-docs-on-stop.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "none"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME\"/.claude/statusline-command.sh",
    "refreshInterval": 15
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash \"$HOME\"/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "outputStyle": "Straight Answers",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "10m",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "timeFormat": "24-hour",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "autoScrollEnabled": false,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "`git commit --no-verify` in ~/dotfiles or the private config layer (the repo `readlink -f ~/.config/git/local.gitconfig` resolves into) when the user has asked to skip or bypass the rule-audit gate. Those two are the user's solo config repos with no CI, and the pre-commit rule-audit is the user's own review step, which the user may waive."
    ]
  }
}
