{
  "skillListingBudgetFraction": 0.03,
  "env": {
    "PATH": "/Users/yossidoctor/.local/share/fnm/aliases/default/bin:/Users/yossidoctor/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "HOMEBREW_NO_ANALYTICS": "1",
    "GIT_PAGER": "cat",
    "PAGER": "cat",
    "LESS": "FRX",
    "CI": "1",
    "NO_COLOR": "1",
    "BASH_MAX_OUTPUT_LENGTH": "100000",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "24",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_GIT_SHOW_COMMIT_HASHES": "1",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(dd *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(diskutil reformat *)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(shred *)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push --mirror *)",
      "Bash(git -C * push --delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh cache delete *)",
      "Bash(gh secret delete *)"
    ],
    "ask": [
      "Bash(git branch -D *)",
      "Bash(git reset --hard *)",
      "Bash(git tag -d *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git -C * push --force-with-lease*)",
      "Bash(git * reset --hard *)",
      "Bash(git * branch -D *)",
      "Bash(git * tag -d *)",
      "Bash(git checkout -- *)",
      "Bash(git * checkout -- *)",
      "Bash(git clean *)",
      "Bash(git * clean *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git * stash drop*)",
      "Bash(git * stash clear*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/yossidoctor/dotfiles"
    ]
  },
  "model": "opus",
  "availableModels": [
    "fable",
    "opus",
    "sonnet",
    "haiku"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ask-matt-banner.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/enforce-foreground-polling.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/enforce-read-over-shell-read.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/enforce-git-add-paths.sh",
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/fill-subagent-model.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/redirect-symlink-edits.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/warn-existing-occurrence.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/log-permission-denied.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/caffeinate-claude.sh active",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/caffeinate-claude.sh linger",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/audit-docs-on-stop.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/notify-agent-idle.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/LaunchAgents",
        "~/.claude-swap-backup",
        "~/.config/git/allowed_signers"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" }
      ]
    }
  },
  "cleanupPeriodDays": 30,
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME\"/.claude/statusline-command.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash \"$HOME\"/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "outputStyle": "Straight Answers",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "autoScrollEnabled": false,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "hold",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "timeFormat": "24-hour"
}
