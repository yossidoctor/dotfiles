<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.yossidoctor.cswap-auto</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/yossidoctor/.local/bin/cswap</string>
		<string>auto</string>
		<string>--model</string>
		<string>all</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>/Users/yossidoctor/.claude-swap-backup/auto-stderr.log</string>
</dict>
</plist>
