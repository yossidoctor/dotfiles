<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Spotlight: local results only. Apple's online "Siri Suggestions"
	     (Wikipedia cards, news, web search rows) ignore every switch in the
	     Spotlight settings pane on macOS 27; this is Apple's documented
	     restriction for them (Restrictions payload, macOS 10.11+). Installed
	     by hand: open the file, then System Settings › General › Device
	     Management › Install. ./install lists it under "Needs you" until the
	     key shows up in /Library/Managed Preferences. -->
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.applicationaccess</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>dev.yossidoctor.spotlight.restrictions</string>
			<key>PayloadUUID</key>
			<string>95057D81-E519-4284-ADA1-103C972E00DB</string>
			<key>PayloadDisplayName</key>
			<string>Spotlight: no internet results</string>
			<key>allowSpotlightInternetResults</key>
			<false/>
		</dict>
	</array>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>dev.yossidoctor.spotlight</string>
	<key>PayloadUUID</key>
	<string>9283920E-2510-4949-AF85-614C13B9C84A</string>
	<key>PayloadDisplayName</key>
	<string>Spotlight: local results only</string>
	<key>PayloadDescription</key>
	<string>Turns off Spotlight's internet results (Siri Suggestions, Wikipedia, news, web search). Local files, apps and system items are unaffected.</string>
	<key>PayloadOrganization</key>
	<string>dotfiles</string>
	<key>PayloadScope</key>
	<string>User</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
</dict>
</plist>
