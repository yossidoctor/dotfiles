#!/bin/bash
set -e
BASEDIR=$(cd "$(dirname "$0")" && pwd)

[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
if ! command -v brew >/dev/null 2>&1; then
  echo 'install: Homebrew missing — run: /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"' >&2
  exit 1
fi

grep -oE '^tap "[^"]+"' "$BASEDIR/brew/Brewfile" | cut -d'"' -f2 | xargs brew trust --tap >/dev/null
brew bundle check --file "$BASEDIR/brew/Brewfile" >/dev/null 2>&1 \
  || brew bundle --file "$BASEDIR/brew/Brewfile" --quiet

dotbot -d "$BASEDIR" -c "$BASEDIR/install.conf.yaml" "$@"

# Last on screen: what this install cannot do by itself. mac/spotlight.sh
# needs sudo and may need a Search Privacy edit, so it runs here with a TTY
# rather than as a dotbot step, whose output and stdin dotbot suppresses.
echo
echo "== Needs you =="
bash "$BASEDIR/mac/spotlight.sh" 2>&1 | grep -v "Indexing enabled" | sed 's/^/  /' || true
plutil -p "/Library/Managed Preferences/$USER/com.apple.applicationaccess.plist" 2>/dev/null | grep -q '"allowSpotlightInternetResults" => false' \
  || echo "  Spotlight profile: open mac/profiles/spotlight-no-internet-results.mobileconfig, then System Settings › General › Device Management › Install"
echo "  GitHub: add ~/.config/git/signing/personal.pub as a Signing key on each account"
echo "  Accessibility: allow Hammerspoon, AeroSpace and Karabiner when each first asks"
echo "  Claude accounts: cswap add <name> for each one"
