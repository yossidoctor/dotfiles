#!/bin/bash
# Commit gate for ~/dotfiles, four checks.
#
# This is a public repo, so the staged tree may name no
# private layer and nothing from the employer's world: the denylist below is
# the gate, a hit blocks the commit and prints the line, and this file is the
# one path excluded from its own scan. gitleaks scans the same staged diff for
# secret-shaped strings (tokens, keys) — the class GitHub's push protection
# pattern list misses, and cheaper to stop here than to rotate after a push.
# Then scripts/check-doc-refs.sh
# (deployed as check-doc-refs) fails the commit when a skill cites a file or a
# `skills/…` path that does not exist, or an install.conf.yaml `link:` names an
# absent source — the classes that break a fresh clone; § citations only warn.
# Last, claude/hooks/tests/run-tests.sh, on every commit rather than only when
# claude/hooks/ is staged: a case can break from a deletion anywhere in the tree.

set -euo pipefail

root=$(git rev-parse --show-toplevel)

case "$root" in "$HOME/dotfiles") ;; *) exit 0 ;; esac

hits=$(git grep --cached -n -i -E '(^|[^a-z])dono([^a-z]|$)|qovery|donohq|@dono\.ai|donofiles' -- . ':!git/hooks/pre-commit') && rc=0 || rc=$?
if [ "$rc" -gt 1 ]; then
  echo "pre-commit: the private-term scan itself failed (git grep exit $rc) — a scan that did not run is not a clean scan." >&2
  exit 1
fi
if [ -n "$hits" ]; then
  printf '%s\n' "$hits" >&2
  echo "pre-commit: the staged tree names a private layer or an employer term (above) — this repo is public." >&2
  exit 1
fi

if command -v gitleaks >/dev/null && ! report=$(gitleaks git --pre-commit --staged --no-banner --redact 2>&1); then
  printf '%s\n' "$report" >&2
  echo "gitleaks: the staged diff carries a secret-shaped string (above) — this repo is public." >&2
  exit 1
fi

report=$(bash "$root/scripts/check-doc-refs.sh" "$root" 2>&1) || {
  printf '%s\n' "$report" >&2
  echo "check-doc-refs: broken doc/config references (above) — fix, or run check-doc-refs --strict for the § warnings." >&2
  exit 1
}

report=$(bash "$root/claude/hooks/tests/run-tests.sh" 2>&1) || {
  printf '%s\n' "$report" >&2
  echo "hook tests: a PreToolUse hook case failed (above) — this repo's hooks and their case files ship together." >&2
  exit 1
}
