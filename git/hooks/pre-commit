#!/usr/bin/env bash
# Commit gate for ~/dotfiles, three checks. This is a public repo, so the staged
# tree may name no private layer and nothing from the employer's world: the
# denylist below is the gate, a hit blocks the commit and prints the line, and
# this file is the one path excluded from its own scan. Then scripts/check-doc-refs.sh
# (deployed as check-doc-refs) fails the commit when a skill cites a file or a
# `skills/…` path that does not exist, or an install.conf.yaml `link:` names an
# absent source — the classes that break a fresh clone; § citations only warn.
#
# Third: scripts/rule-audit-gate.sh, which refuses a staged rule file that has
# no audit receipt for its current content. Commit is the right boundary for
# that audit — a turn is arbitrary, and a rule change spanning four turns gets
# audited four times and never as a whole. The audit itself runs in a session
# that did not write the files, which is where the measured gains are; the gate
# only checks that one happened (docs/claude/instructing-claude.md § 7).
#
# The first two checks are ~/dotfiles-only. The rule-audit gate runs in every
# rule repo, since a layer repo's skills bind exactly as hard as this one's.

set -euo pipefail

root=$(git rev-parse --show-toplevel)

if [ -f "$root/scripts/rule-audit-gate.sh" ]; then
  bash "$root/scripts/rule-audit-gate.sh" "$root" || exit 1
elif [ -f "$HOME/dotfiles/scripts/rule-audit-gate.sh" ]; then
  bash "$HOME/dotfiles/scripts/rule-audit-gate.sh" "$root" || exit 1
fi

case "$root" in "$HOME/dotfiles") ;; *) exit 0 ;; esac

if hits=$(git grep --cached -n -i -E '(^|[^a-z])dono([^a-z]|$)|qovery|donohq|@dono\.ai|donofiles' -- . ':!git/hooks/pre-commit' 2>/dev/null) && [ -n "$hits" ]; then
  printf '%s\n' "$hits" >&2
  echo "pre-commit: the staged tree names a private layer or an employer term (above) — this repo is public." >&2
  exit 1
fi

report=$(bash "$root/scripts/check-doc-refs.sh" "$root" 2>&1) || {
  printf '%s\n' "$report" >&2
  echo "check-doc-refs: broken doc/config references (above) — fix, or run check-doc-refs --strict for the § warnings." >&2
  exit 1
}
