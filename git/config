# Router + shared identity. Name is shared (here); the personal email is
# git/identity, included for ~/dotfiles below. Another layer adds its own
# tree's identity through ~/.config/git/local.gitconfig, which it deploys and
# this file includes when present. credential-helper.sh routes github.com auth
# by the identity files in ~/.config/git/identities.d/. useConfigOnly = true
# means a commit outside every included scope fails loud until a per-repo
# identity is set or a layer adds its scope.

[user]
	name = Yossi Doctor
	useConfigOnly = true

[core]
	excludesFile = ~/.gitignore_global
	pager = delta
	fsmonitor = true
	untrackedCache = true

[credential "https://github.com"]
	helper =
	helper = !$HOME/dotfiles/git/credential-helper.sh
	useHttpPath = true

[credential "https://gist.github.com"]
	helper =
	helper = !$HOME/dotfiles/git/credential-helper.sh
	useHttpPath = true

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	followTags = true

[pull]
	autoStash = true

[fetch]
	prune = true
	pruneTags = true

[rebase]
	autoStash = true
	updateRefs = true
	autoSquash = true
	missingCommitsCheck = error

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true          # n/N to jump between diff hunks
	line-numbers = true
	side-by-side = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[rerere]
	enabled = true
	autoupdate = true

[help]
	autocorrect = prompt

[commit]
	verbose = true

[log]
	date = iso

[includeIf "gitdir:~/dotfiles/"]
	path = ~/dotfiles/git/identity

[include]
	path = ~/.config/git/local.gitconfig

[alias]
	st = status
	co = checkout
	br = branch
	cb = checkout -b
	ci = commit
	last = log -1 HEAD
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	lg = log --color --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	dft = -c diff.external=difft diff
