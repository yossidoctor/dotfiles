# Router + shared identity. Name is shared (here); the personal email and
# signing key are git/identity, included for ~/dotfiles below. Another layer
# adds its own tree's identity through ~/.config/git/local.gitconfig, which it
# deploys and this file includes when present. credential-helper.sh routes
# github.com auth by the identity files in ~/.config/git/identities.d/.
# useConfigOnly = true means a commit outside every included scope fails loud
# until a per-repo identity is set or a layer adds its scope.
#
# ~/.gitconfig is a symlink into this repo, and git rewrites a config file by
# rename, so any `git config --global` write — `git maintenance register`
# included — would replace the link with a copy. Machine-local state goes to
# ~/.config/git/machine.gitconfig, untracked and included last:
#   git maintenance register --config-file ~/.config/git/machine.gitconfig

[user]
	name = Yossi Doctor
	useConfigOnly = true

[core]
	excludesFile = ~/.gitignore_global
	attributesFile = ~/.gitattributes_global
	pager = delta
	fsmonitor = true
	untrackedCache = true

# Every commit and tag is SSH-signed with the identity's key (user.signingkey
# in each identity file; the keys live in ~/.config/git/signing/, generated by
# ./install, passphrase-free so an unattended session can commit). GitHub shows
# Verified once the public key is added to the matching account as a SIGNING
# key. allowed_signers is machine-local and assembled by each layer's install.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[credential "https://github.com"]
	helper =
	helper = !$HOME/dotfiles/git/credential-helper.sh
	useHttpPath = true

[credential "https://gist.github.com"]
	helper =
	helper = !$HOME/dotfiles/git/credential-helper.sh
	useHttpPath = true

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true

[pull]
	autoStash = true

[fetch]
	prune = true
	pruneTags = true

[rebase]
	autoStash = true
	updateRefs = true
	autoSquash = true
	missingCommitsCheck = error
	rebaseMerges = no-rebase-cousins

[merge]
	conflictStyle = zdiff3
	directoryRenames = true

# Syntax-aware merges for the languages mergiraf parses; git/attributes
# assigns the driver per extension. Falls back to git's own merge when unsure.
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[diff]
	algorithm = histogram
	colorMoved = default

[status]
	compareBranches = @{upstream} @{push}

[index]
	version = 4
	skipHash = true

[blame]
	ignoreRevsFile = .git-blame-ignore-revs
	markUnblamableLines = true

[maintenance]
	strategy = geometric

[absorb]
	maxStack = 50

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true          # n/N to jump between diff hunks
	line-numbers = true
	side-by-side = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname
	gpgsign = true

[column]
	ui = auto

[rerere]
	enabled = true
	autoupdate = true

[help]
	autocorrect = prompt

[commit]
	verbose = true
	gpgsign = true

[log]
	date = iso

[includeIf "gitdir:~/dotfiles/"]
	path = ~/dotfiles/git/identity

[include]
	path = ~/.config/git/local.gitconfig
	path = ~/.config/git/machine.gitconfig

[alias]
	st = status
	co = checkout
	br = branch
	cb = checkout -b
	ci = commit
	last = log -1 HEAD
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	lg = log --color --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	dft = -c diff.external=difft diff
