#!/usr/bin/env bash
# sketchybarrc — the bar's entry point; every item is declared here, every
# behavior lives in a sibling plugin. Run by sketchybar itself on start and on
# `sketchybar --reload`.
#
# Geometry is tied to JankyBorders, exactly as aerospace.toml's [gaps] are:
# BAR_HEIGHT drives `gaps.outer.top` in aerospace.toml (top = BAR_HEIGHT + 6),
# so a change here needs that value changed with it or windows tile under the bar.
#
# Workspaces are pinned to monitors by the `display` property, mirroring
# aerospace.toml's [workspace-to-monitor-force-assignment]; WS_DISPLAY below is
# the single carrier of that mapping for the bar side. Unpinned workspaces take
# display=active and follow the focused screen, matching AeroSpace placing them
# on whichever monitor is focused when first summoned.
#
# App icons come from sketchybar-app-font via icon_map.sh, which is sourced once
# per refresh rather than exec'd per window: measured 5.1ms for four sourced
# lookups against 6.5ms for a single fork (hyperfine, 40 runs).
set -euo pipefail

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGINS="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/theme.sh"

BAR_HEIGHT=38
ITEM_HEIGHT=24
GROUP_PADDING=5

# workspace -> display index. Workspaces absent here are unpinned and follow the
# focused monitor. Mirrors aerospace.toml [workspace-to-monitor-force-assignment].
WS_DISPLAY_1=1
WS_DISPLAY_2=1
WS_DISPLAY_3=2
WS_DISPLAY_4=2
WS_DISPLAY_5=3
WS_DISPLAY_6=3

# The workspaces alt-1..alt-9 in aerospace.toml can reach. Declared, not
# discovered: `aerospace list-workspaces --all` omits an empty workspace, and a
# chip that appears only once a window lands there defeats always-drawing all
# nine. plugins/aerospace.sh paints exactly this set, and reads it back from the
# bar's own items rather than carrying a second copy.
WORKSPACES="1 2 3 4 5 6 7 8 9"

MONITOR_COUNT=$(aerospace list-monitors --count)

# A workspace pinned to display=3 draws nowhere when only one monitor is
# attached, which silently deletes chips 3-6 on the laptop. Pin only to a
# monitor that exists; everything else follows the focused display.
ws_display() {
  local var="WS_DISPLAY_$1"
  local want="${!var:-active}"
  case "$want" in
    active) printf 'active' ;;
    *) if [ "$want" -le "$MONITOR_COUNT" ]; then printf '%s' "$want"; else printf 'active'; fi ;;
  esac
}

# Full-bleed strip: no corner_radius, no margin, no y_offset, so the bar
# occupies the menu bar's own geometry.
#
# blur_radius is 0 because BAR_BG is opaque — see theme.sh for why it has to be.
# A backdrop blur behind a fill nothing shows through costs a compositor pass
# and renders nothing, so the two settings move together: restoring any
# translucency to BAR_BG means restoring the blur with it, and brings the menu
# bar's bleed back too.
sketchybar --bar \
  height="$BAR_HEIGHT" \
  position=top \
  sticky=on \
  padding_left=12 \
  padding_right=12 \
  color="$BAR_BG" \
  blur_radius=0 \
  corner_radius=0 \
  margin=0 \
  y_offset=0 \
  shadow=off \
  topmost=on \
  show_in_fullscreen=on \
  font_smoothing=on

# No background on any item: text sits directly on the bar, so the shadow below
# carries the legibility. Two things do draw a fill — the focused workspace
# chip, painted by plugins/aerospace.sh, and the per-monitor group tiles below.
#
# updates=when_shown keeps a hidden item from running its script at all, which is
# what makes the hover-collapsed right side free at rest.
sketchybar --default \
  updates=when_shown \
  background.drawing=off \
  background.height="$ITEM_HEIGHT" \
  background.border_width=0 \
  icon.font="$FONT_TEXT:Semibold:13.0" \
  icon.color="$TEXT" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  icon.shadow.drawing=on \
  icon.shadow.color="$TEXT_SHADOW" \
  icon.shadow.angle="$SHADOW_ANGLE" \
  icon.shadow.distance="$SHADOW_DISTANCE" \
  label.font="$FONT_TEXT:Medium:12.5" \
  label.color="$SUBTEXT" \
  label.padding_left=0 \
  label.padding_right=8 \
  label.shadow.drawing=on \
  label.shadow.color="$TEXT_SHADOW" \
  label.shadow.angle="$SHADOW_ANGLE" \
  label.shadow.distance="$SHADOW_DISTANCE" \
  padding_left="$GROUP_PADDING" \
  padding_right="$GROUP_PADDING"

# AeroSpace has no native sketchybar event; both are minted here and triggered
# from aerospace.toml's callbacks. workspace_change fires on every switch.
# window_change has no single upstream source — there is no window-closed and
# no window-minimized event (docs/aerospace/UPSTREAM-2026-09.md § 1) — so it is
# fired from every signal a close can reach: on-window-detected and
# on-focus-changed in aerospace.toml, retry-poke.sh off the Cmd+W/Cmd+Q
# keystroke, and the retile-on-quit-watcher LaunchAgent.
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_window_change
sketchybar --add event media_update

# The focused chip is the only filled shape in the bar, so highlight_color is
# the color the text takes ON that fill rather than an accent tint: the fill is
# white and ON_ACCENT inverts the glyphs to near-black over it.
# plugins/aerospace.sh swaps each chip's fill, and paints an empty workspace
# fainter than an occupied one.
# A marker glyph opens each monitor's run of chips, so the row reads as groups
# rather than nine loose numbers. It is emitted when the display a workspace is
# pinned to differs from the previous one, which means the markers follow
# WS_DISPLAY_* automatically and a re-pinning needs no change here.
#
# `active` is a real group, not a fallthrough to skip: ws_display returns it
# both for a workspace with no pin and for one pinned to a monitor that is not
# attached, and either way those workspaces follow the focused screen. They get
# the external glyph, since that is where a roaming workspace usually lands.
#
# The marker carries the SAME `display=` as the chips it heads. Without it the
# marker draws on every screen while its chips draw only on theirs, so a group
# whose chips live on another monitor leaves an orphaned glyph sitting against
# the next group's marker — two display icons side by side with nothing between
# them.
prev_display=""
group_members=""
for sid in $WORKSPACES; do
  this_display="$(ws_display "$sid")"
  if [ "$this_display" != "$prev_display" ]; then
    case "$this_display" in
      2) marker_icon="$ICON_DISPLAY_BUILTIN" ;;
      *) marker_icon="$ICON_DISPLAY_EXTERNAL" ;;
    esac
    sketchybar --add item "spaces.group.$sid" left \
      --set "spaces.group.$sid" \
        display="$this_display" \
        icon="$marker_icon" \
        icon.font="$FONT_TEXT:Regular:12.0" \
        icon.color="$IDLE" \
        icon.padding_left=0 \
        icon.padding_right=0 \
        label.drawing=off \
        background.drawing=off \
        padding_left=8 \
        padding_right=4
    prev_display="$this_display"
    # Each group's bracket is added after the loop, once every member exists —
    # a bracket only draws around items already on the bar.
    group_members="$group_members|spaces.group.$sid"
  fi
  group_members="$group_members space.$sid"

  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
      display="$this_display" \
      icon.font="$FONT_APP:Regular:14.0" \
      icon.color="$SUBTEXT" \
      icon.highlight_color="$ON_ACCENT" \
      icon.padding_left=7 \
      icon.padding_right=7 \
      label.font="$FONT_TEXT:Semibold:12.0" \
      label.padding_left=5 \
      label.padding_right=8 \
      label.highlight_color="$ON_ACCENT" \
      background.corner_radius=11 \
      background.height=22 \
      background.drawing=on \
      background.color=0x00000000 \
      script="$PLUGINS/hover.sh" \
      click_script="aerospace workspace $sid" \
    --subscribe "space.$sid" mouse.entered mouse.exited
done

# One bracket per monitor group, drawn as a faint tile behind that monitor's
# marker and chips. Added here rather than inside the loop because a bracket
# only wraps items that already exist on the bar.
#
# group_members is one "|"-separated record per group, each holding the marker
# id followed by its chips; splitting on "|" and dropping the empty leading
# field yields exactly the member list each bracket needs.
IFS='|'
for record in $group_members; do
  [ -z "$record" ] && continue
  unset IFS
  set -- $record
  head="$1"
  sketchybar --add bracket "${head}.tile" $record \
    --set "${head}.tile" \
      background.drawing=on \
      background.color="$GROUP_BG" \
      background.border_color="$GROUP_BORDER" \
      background.border_width=1 \
      background.corner_radius=13 \
      background.height=26
  IFS='|'
done
unset IFS

# One painter for all nine chips, driven by an item that draws nothing: the
# chips carry no script of their own, so a single event fires a single
# `aerospace list-windows --all` instead of one CLI call per chip.
# updates=on must be explicit: the default is `when_shown`, and a drawing=off
# item is never shown, so its script would never run on any event.
sketchybar --add item spaces.painter left \
  --set spaces.painter drawing=off updates=on \
    script="$PLUGINS/aerospace.sh" \
  --subscribe spaces.painter aerospace_workspace_change aerospace_window_change

# A hairline between the workspace chips and the focused-window tile, drawn as a
# glyph rather than as a 1px background: a background that thin has no room to
# paint once the item's own padding is applied, and renders as nothing at all.
#
# The gap is measured to what is DRAWN on each side, which on the right is the
# edge of front_app's hover pill, not its glyph: icon.padding_left sits INSIDE
# that background and so adds nothing to the gap. front_app carries no item
# padding of its own, while the chip on the left ends with its inherited
# GROUP_PADDING of 5 — so the left value is the right one minus that 5, and both
# visible gaps come to 11.
sketchybar --add item divider.apps left \
  --set divider.apps \
    icon="│" \
    icon.font="$FONT_TEXT:Regular:15.0" \
    icon.color="$DIVIDER" \
    icon.padding_left=0 \
    icon.padding_right=0 \
    icon.shadow.drawing=off \
    label.drawing=off \
    background.drawing=off \
    padding_left=6 \
    padding_right=11

# The focused window, on the left after the workspace chips. NOT center_left:
# that anchors to the left edge of the notch and the tile is long enough to run
# back underneath the camera housing, which hides the start of the title. The
# left side flows rightward from the chips and simply stops short of the notch.
sketchybar --add item front_app left \
  --set front_app \
    icon.font="$FONT_APP:Regular:14.0" \
    icon.color="$TEXT" \
    icon.padding_left=10 \
    icon.padding_right=7 \
    label.font="$FONT_TEXT:Medium:12.0" \
    label.color="$SUBTEXT" \
    label.padding_right=12 \
    padding_left=0 \
    padding_right=0 \
    background.corner_radius=11 \
    background.height=22 \
    background.drawing=on \
    background.color=0x00000000 \
    updates=on \
    script="$PLUGINS/front-app.sh" \
  --subscribe front_app front_app_switched aerospace_window_change \
    aerospace_workspace_change mouse.entered mouse.exited

# Right side is laid out right-to-left: the clock is added first so it sits
# outermost. It is deliberately NOT in the hover GROUP — a time you have to hover
# for is not a clock — so it carries no collapsed label; it does take the hover
# fill, so the bar responds to the pointer consistently.
#
# font.features=tnum holds the digits on a fixed advance, so the minute ticking
# over cannot shift the clock's width and nudge everything left of it.
#
# The right edge is split between label.padding_right and the item's own
# padding_right, and the two must sum to the 5 the leftmost chip inherits, so
# the time's ink ends the same distance from the screen edge as that chip's
# pill begins from its own.
#
# The label keeps the larger share because a glyph needs room for its right
# side bearing: at label.padding_right=0 the final digit was clipped mid-stroke,
# and a `9` lost its bowl.
sketchybar --add item clock right \
  --set clock \
    background.height="$ITEM_HEIGHT" \
    icon="$(date '+%a %d %b')" \
    icon.font="$FONT_TEXT:Medium:12.0" \
    icon.color="$SUBTEXT" \
    icon.padding_left=10 \
    icon.padding_right=6 \
    label.padding_left=4 \
    label.font="$FONT_NUM:Semibold:12.0" \
    label.font.features=tnum \
    label.color="$TEXT" \
    label.padding_right=4 \
    padding_right=1 \
    background.corner_radius=11 \
    background.drawing=on \
    background.color=0x00000000 \
    update_freq=30 \
    script="$PLUGINS/clock.sh" \
    click_script="open -a Calendar" \
  --subscribe clock system_woke mouse.entered mouse.exited

# The hover group: collapsed to a bare icon, label revealed on mouse.entered.
# label.width=0 is the collapsed state; the plugin animates it to dynamic.
# background.corner_radius here is what makes the HOVER fill a pill rather than
# a sharp rectangle: these items draw no background at rest (the color is
# transparent) and each plugin swaps in HOVER_BG on mouse.entered, so the radius
# is only ever visible under the pointer.
for item in battery volume media; do
  sketchybar --add item "$item" right \
    --set "$item" label.width=0 \
      background.drawing=on \
      background.color=0x00000000 \
      background.corner_radius=11 \
      background.height=22 \
    --subscribe "$item" mouse.entered mouse.exited
done

sketchybar --set battery \
  icon.font="$FONT_TEXT:Regular:14.0" \
  icon.padding_left=7 \
  icon.padding_right=6 \
  label.font="$FONT_NUM:Medium:12.0" \
  label.font.features=tnum \
  update_freq=180 \
  script="$PLUGINS/battery.sh" \
  click_script="sketchybar --set battery popup.drawing=toggle" \
  popup.background.color="$POPUP_BG" \
  popup.background.corner_radius=10 \
  popup.background.shadow.drawing=on \
  popup.blur_radius=25 \
  popup.y_offset=4 \
  popup.align=right

# Popup rows sit on the popup's own blurred panel, so their text needs no
# shadow — the panel already supplies the contrast the bar's glass does not.
sketchybar --add item battery.remaining popup.battery \
  --set battery.remaining \
    icon="remaining" \
    icon.font="$FONT_TEXT:Regular:12.0" \
    icon.color="$SUBTEXT" \
    icon.shadow.drawing=off \
    label.font="$FONT_NUM:Medium:12.0" \
    label.color="$TEXT" \
    label.shadow.drawing=off \
    background.drawing=off \
    width=150

sketchybar --subscribe battery power_source_change system_woke

sketchybar --set volume \
  icon.font="$FONT_TEXT:Regular:14.0" \
  icon.padding_left=7 \
  icon.padding_right=6 \
  label.font="$FONT_NUM:Medium:12.0" \
  label.font.features=tnum \
  script="$PLUGINS/volume.sh" \
  click_script="$PLUGINS/volume.sh" \
  popup.background.color="$POPUP_BG" \
  popup.background.corner_radius=10 \
  popup.background.shadow.drawing=on \
  popup.blur_radius=25 \
  popup.y_offset=4 \
  popup.align=right \
  --subscribe volume volume_change mouse.scrolled mouse.clicked

# Media reads whatever owns the system now-playing session — macOS exposes only
# one to third parties, so this follows the active app rather than tracking
# Spotify specifically, and it cannot be pinned to one app. Fed by the
# media-stream LaunchAgent triggering media_update; the item never polls.
# updates=on, not the inherited when_shown: this item starts hidden (nothing is
# playing yet) and a when_shown item runs no script while hidden, so it could
# never react to the media_update that should bring it back.
sketchybar --set media \
  icon.font="$FONT_TEXT:Regular:14.0" \
  icon.padding_left=7 \
  icon.padding_right=6 \
  label.font="$FONT_TEXT:Medium:12.0" \
  drawing=off \
  updates=on \
  script="$PLUGINS/media.sh" \
  popup.background.color="$POPUP_BG" \
  popup.background.corner_radius=10 \
  popup.background.shadow.drawing=on \
  popup.blur_radius=25 \
  popup.y_offset=4 \
  popup.align=right \
  update_freq=5 \
  --subscribe media media_update mouse.exited.global system_woke

# One row per audio source. macOS hands third parties only a single now-playing
# session, so every row past the first is a player read through its own
# scripting dictionary — see plugins/media.sh. Rows draw only when their source
# has a track loaded.
#
# The transport glyph is each row's ICON, not a character appended to its label,
# and the icon is drawn before the label in a fixed-width slot. That is what
# pins it to a column: a glyph inside the label text tracks the text and lands
# at a different x on every row, since SF Pro is proportional and no amount of
# space padding aligns it. The source is then identified by that glyph's brand
# TINT rather than by a second app glyph competing beside it.
#
# There is no shared prev/play/next strip: popup.horizontal is a per-popup
# setting, so a horizontal button row cannot coexist with this vertical list.
# Each row is its own play/pause instead, which with more than one source is the
# control that was actually missing — "pause THIS one".
#
# Clicking a row toggles that source and REPAINTS the popup rather than closing
# it — a play/pause you have to reopen the menu to undo is a worse control than
# the one it replaced. media.sh is re-run so the row's glyph flips to match.
# dynamic, not a fixed width: a fixed one clips the long titles this list exists
# to show. The rows are left-aligned and the popup sizes to its widest row, so
# they still line up with each other.
ROW_LABEL_WIDTH=dynamic
# A click_script runs with a minimal PATH carrying /usr/bin but NOT Homebrew's
# prefix, so a bare `media-control` is not found and the click silently does
# nothing — no error reaches the bar. Anything from Homebrew is therefore named
# by absolute path; the osascript rows below need no such treatment, since
# /usr/bin is already on that PATH.
BREW_BIN="/opt/homebrew/bin"
MEDIA_REPAINT="rm -f \"\${TMPDIR:-/tmp}/sketchybar-media-popup-leave\"; sleep 0.35; NAME=media SENDER=media_refresh $PLUGINS/media.sh"

for row in system spotify vlc; do
  sketchybar --add item "media.row.$row" popup.media \
    --set "media.row.$row" \
      drawing=off \
      icon.font="$FONT_TEXT:Regular:13.0" \
      icon.color="$TEXT" \
      icon.shadow.drawing=off \
      icon.padding_left=14 \
      icon.padding_right=10 \
      icon.width=26 \
      icon.align=center \
      label.font="$FONT_TEXT:Medium:12.0" \
      label.color="$TEXT" \
      label.shadow.drawing=off \
      label.align=left \
      label.width="$ROW_LABEL_WIDTH" \
      label.padding_right=14 \
      background.drawing=on \
      background.color=0x00000000 \
      background.corner_radius=7 \
      background.height=26 \
      script="$PLUGINS/media-row.sh" \
    --subscribe "media.row.$row" mouse.entered mouse.exited
done

sketchybar --set media.row.system \
  click_script="$BREW_BIN/media-control toggle-play-pause; $MEDIA_REPAINT"
sketchybar --set media.row.spotify \
  click_script="osascript -e 'tell application \"Spotify\" to playpause'; $MEDIA_REPAINT"
sketchybar --set media.row.vlc \
  click_script="osascript -e 'tell application \"VLC\" to play'; $MEDIA_REPAINT"

# Build pointer-y if it is missing or older than its source. Kept quiet and
# non-fatal: without it the media popup falls back to closing on a row's own
# exit, which is worse but not broken.
if [ ! -x "$CONFIG_DIR/pointer-y" ] || \
   [ "$CONFIG_DIR/pointer-y.c" -nt "$CONFIG_DIR/pointer-y" ]; then
  (cd "$CONFIG_DIR" && make >/dev/null 2>&1) || true
fi

sketchybar --hotload on
sketchybar --update
