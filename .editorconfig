root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Git config files use tabs (git's own convention).
[git/{config,config-personal}]
indent_style = tab

# Markdown: trailing whitespace can be a hard line break — don't strip.
[*.md]
trim_trailing_whitespace = false
