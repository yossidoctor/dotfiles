# /etc/zprofile runs path_helper on login shells, which hoists /usr/bin ahead of
# the dirs .zshenv set. Re-prepend in the same order (zshrc runs after zprofile);
# `typeset -U path` in zshenv drops the copies path_helper left behind.
path=("$HOME/.local/bin" "$BREW_PREFIX/bin" "$BREW_PREFIX/sbin" $path)

# History. /etc/zshrc sets SAVEHIST=1000, which drops everything older on every
# exit. EXTENDED_HISTORY records start time and duration per command;
# SHARE_HISTORY merges the parallel terminals as they run; a leading space
# keeps a command out.
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# Completion. Homebrew's site-functions go on fpath first: the system zsh does
# not look there, and it is where brew formulae ship their completions (gh,
# eza, fd, rg, aerospace, uv, …). -C trusts the existing dump instead of
# compaudit-ing every fpath entry per shell (single-user machine; brew owns the
# dirs); a new fpath dir needs that dump rebuilt once: `rm ~/.zcompdump`.
# Existence guards throughout: on a fresh machine every new shell works before
# `brew bundle` has installed the plugins/tools.
fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit && compinit -C

# fzf key bindings (Ctrl-R history, Ctrl-T files, Alt-C cd) and `**<Tab>` paths.
command -v fzf >/dev/null && source <(fzf --zsh)

# Prompt.
command -v starship >/dev/null && eval "$(starship init zsh)"

# Modern CLI replacements (installed via brew/Brewfile personal section).
# Skipped under Claude Code: these change core-command output format, which
# breaks the agent's tool parsing (e.g. `ls` -> eza swallowed plain output).
if [[ -z "$CLAUDECODE" ]]; then
  alias cat='bat --paging=never'
  alias ls='eza --icons --git --group-directories-first'
  alias ll='eza -la --icons --git --group-directories-first'
  alias du='dust'
  alias df='duf'
  alias ps='procs'
fi
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"   # adds `z` / `zi`; leaves `cd` untouched

# Claude Code reads ~/.claude/CLAUDE.md as a user message, which its own docs
# call context rather than enforced configuration, with no compliance
# guarantee. --append-system-prompt puts the same text in the system prompt,
# where it is re-sent every request (docs/claude/instructing-claude.md § 2).
#
# The file therefore loads twice, measured at 6,232 duplicate tokens. That is
# deliberate: this function covers the terminal only, so dropping the deployed
# ~/.claude/CLAUDE.md link would leave an IDE or web session with no global
# rules at all. Both copies sit in the cached prefix at 0.1x input, so the
# duplicate costs a fraction of a cent per session — cheaper than the hole.
#
# A function, not an alias, so `claude mcp`, `claude agents` and `claude -p`
# keep their arguments.
claude() {
  local rules="$HOME/.claude/CLAUDE.md"
  if [[ -r "$rules" ]]; then
    command claude --append-system-prompt-file "$rules" "$@"
  else
    command claude "$@"
  fi
}

source "$HOME/dotfiles/brew/env.sh"

# fnm — per-service Node version via .nvmrc; auto-switch on cd
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"

# fzf-tab replaces the completion menu with an fzf fuzzy selector; load after
# compinit and before syntax highlighting (which must be last of the widget-binders).
[[ -r "$BREW_PREFIX/share/fzf-tab/fzf-tab.zsh" ]] \
  && source "$BREW_PREFIX/share/fzf-tab/fzf-tab.zsh"
[[ -r "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] \
  && source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
